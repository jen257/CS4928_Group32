diff --git a/before/production/org/jsoup/parser/TokenQueue.java b/after/production/org/jsoup/parser/TokenQueue.java
index 269a755..fde5e55 100644
--- a/before/production/org/jsoup/parser/TokenQueue.java
+++ b/after/production/org/jsoup/parser/TokenQueue.java
@@ -36,11 +36,21 @@ public class TokenQueue {
     }
 
     /**
-     * Retrieves but does not remove the first character from the queue.
-     * @return First character, or 0 if empty.
+     * Looks ahead without advancing the queue.
+     * @param offset non-negative distance from the current position
+     * @return the character at that offset, or 0 beyond the remaining input
+     * @throws IllegalArgumentException if offset is negative
      */
-    public char peek() {
-        return isEmpty() ? 0 : queue.charAt(pos);
+    public char peek(int offset) {
+        if (offset < 0) {
+            throw new IllegalArgumentException(
+                "offset must be non-negative"
+            );
+        }
+
+        return offset >= remainingLength()
+            ? 0
+            : queue.charAt(pos + offset);
     }
 
