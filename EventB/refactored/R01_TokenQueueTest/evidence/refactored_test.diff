+    @Test
+public void testPeekWithOffset() {
+    TokenQueue tq = new TokenQueue("abc");
+
+    assertEquals("Offset 0 should return 'a'",
+            'a', tq.peek(0));
+
+    assertEquals("Offset 1 should return 'b'",
+            'b', tq.peek(1));
+
+    assertEquals("Offset 2 should return 'c'",
+            'c', tq.peek(2));
+
+    assertEquals("Out-of-range offset should return 0",
+            '\0', tq.peek(3));
+
+    assertEquals("Peek should not consume characters",
+            'a', tq.peek(0));
+
+    tq.advance();
+
+    assertEquals("Offset 1 after advance should return 'c'",
+            'c', tq.peek(1));
